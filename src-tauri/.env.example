# Copy to src-tauri/.env (gitignored) and fill in what you use. Everything is optional:
# without a value, that feature is off and Sanctum says so in Setup. See docs/self-hosting.md.

# Google Calendar (Setup > Connections). A Desktop OAuth client from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The optional account and accountability partner. Your Supabase project's URL and
# publishable key (public by design; row-level security guards the data).
SANCTUM_SUPABASE_URL=
SANCTUM_SUPABASE_KEY=
# Where your partner page is deployed (partner/). Defaults to the local dev server.
SANCTUM_PARTNER_URL=
