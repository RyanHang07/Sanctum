{
  "manifest_version": 3,
  "name": "Sanctum",
  "description": "Seals the sites your Sanctum focus profile blocks, while you're sealed.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["nativeMessaging", "declarativeNetRequest", "tabs", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "incognito": "spanning",
  "web_accessible_resources": [{ "resources": ["blocked.html"], "matches": ["<all_urls>"] }],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Sanctum", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } }
}
