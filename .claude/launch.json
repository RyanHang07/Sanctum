{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 1420
    },
    {
      "name": "partner",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "partner",
        "run",
        "dev"
      ],
      "port": 5174
    },
    {
      "name": "partner-view",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "partner",
        "--config",
        "partner/vite.config.ts",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "extension",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "ext:preview"
      ],
      "port": 5175
    }
  ]
}
